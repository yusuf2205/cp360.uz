# Скопируйте в .env и заполните. Файл .env никогда не публикуйте.
POSTGRES_PASSWORD=придумайте-длинный-случайный-пароль
SECRET_KEY=64-случайных-символа        # python -c "import secrets;print(secrets.token_urlsafe(48))"
WEB_PORT=3280                          # порт сайта в вашей сети

# --- Главный администратор (создаётся при первом запуске) ---
BOOTSTRAP_ADMIN_NAME=Иосиф Админов
BOOTSTRAP_ADMIN_PHONE=+998 90 000 00 00   # по нему администратор входит из офиса
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.uz # запасной вход по паролю (в том числе из внешней сети)
BOOTSTRAP_ADMIN_PASSWORD=смените-после-первого-входа

# --- Вход сотрудников ---
SESSION_DAYS=365                       # на сколько дней устройство запоминает вход
LAN_ONLY_INSTANT_LOGIN=true            # true: из офиса вход сразу, из внешней сети — только с разрешения администратора
TRUSTED_NETWORKS=                      # доп. «свои» сети через запятую, например VPN: 100.64.0.0/10

# --- Уведомления в Telegram (необязательно) ---
# 1) В Telegram откройте @BotFather, команда /newbot, получите токен. 2) Создайте группу снабженцев и добавьте туда бота.
# 3) Узнайте номер группы (например, через @RawDataBot) - он начинается с минуса, вроде -1001234567890.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PUBLIC_BASE_URL=http://192.168.1.105:3280   # адрес сайта, он попадёт в сообщение

# --- Вторая копия данных на внешний диск (необязательно) ---
# Путь к папке на USB-диске или другом томе NAS. Пример: /volumeUSB1/usbshare/cp360-backups
EXTRA_BACKUP_DIR=./data/backups-extra
EXTRA_BACKUP_KEEP_DAYS=60

# --- Распознавание ---
OCR_LANGS=rus+eng+uzb                  # языки OCR для фото и сканов
# ИИ: off | local | external
#  off      - только разбор таблиц/текста/Excel/Word/PDF/OCR, данные не покидают сервер (по умолчанию)
#  local    - любая OpenAI-совместимая модель в вашей сети (Ollama, vLLM)
#  external - сторонний сервис; дополнительно нужно AI_EXTERNAL_ALLOWED=true
AI_MODE=off
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_MODEL=qwen2.5:7b-instruct
AI_API_KEY=
AI_EXTERNAL_ALLOWED=false
STT_URL=                               # необязательно: сервис распознавания речи для голосовых сообщений
